# ─────────────────────────────────────────────
#  Shram Sangam — Environment Variables Template
#  Copy this file to .env.local and fill values
# ─────────────────────────────────────────────

# Supabase / PostgreSQL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct DB connection (for migrations/seeds)
DATABASE_URL=postgresql://shram_admin:shram_secret@localhost:5432/shram_sangam

# Redis (for dispatch queue & rate limiting)
REDIS_URL=redis://localhost:6379

# AI Scope Service
OPENAI_API_KEY=sk-your-openai-key
AI_SCOPE_SERVICE_URL=http://localhost:8000

# Payment Gateway (use Razorpay test keys for hackathon)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# App URLs
NEXT_PUBLIC_CUSTOMER_APP_URL=http://localhost:3000
NEXT_PUBLIC_WORKER_APP_URL=http://localhost:3001
NEXT_PUBLIC_GOVERNANCE_APP_URL=http://localhost:3002

# JWT Secret (for session tokens)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# Twilio / SMS (for OTP and WhatsApp fallbacks)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+91XXXXXXXXXX
